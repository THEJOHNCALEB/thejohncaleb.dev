---
import Layout from "@layouts/Layout.astro";
import SiteHeader from "@components/layout/SiteHeader.astro";

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import dart from "@icons/dart.svg";
import typescript from "@icons/typescript.svg";
import swift from "@icons/swift.svg";
import javascript from "@icons/javascript.svg";
import net from "@icons/net.svg";
import php from "@icons/php.svg";

import flutter from "@icons/flutter.svg";
import react from "@icons/react.svg";

import postgresql from "@icons/postgresql.svg";
import mysql from "@icons/mysql.svg";
import mongo from "@icons/mongodb.svg";
import sqlite from "@icons/sqlite.svg";
import supabase from "@icons/supabase.svg";

import aws from "@icons/aws.svg";
import gcp from "@icons/gcp.svg";
import docean from "@icons/docean.svg";
import docker from "@icons/docker.svg";
import kubernetes from "@icons/kubernetes.svg";
import githubactions from "@icons/githubactions.svg";
import hostinger from "@icons/hostinger.svg";

import openai from "@icons/openai.svg";
import gemini from "@icons/gemini.svg";

import H2 from "@components/mdx/H2.astro";

type Tool = {
  name: string;
  description: string;
  logo: ImageMetadata;
  color: `#${string}`;
};

type ToolCategory = {
  title: string;
  tools: Tool[];
};

const categories: ToolCategory[] = [
  {
    title: "Languages",
    tools: [
      {
        name: "Dart",
        description: "My primary language for Flutter apps, clean and productive.",
        logo: dart,
        color: "#0175C2"
      },
      {
        name: "TypeScript",
        description: "Better JavaScript with static typing, making codebases more predictable.",
        logo: typescript,
        color: "#3178C6"
      },
      {
        name: "Swift",
        description: "Native iOS development language.",
        logo: swift,
        color: "#F05138"
      },
      {
        name: "JavaScript",
        description: "For web frontends and quick scripts.",
        logo: javascript,
        color: "#F7DF1E"
      },
      {
        name: "C#",
        description: "My primary language for building robust full-stack web applications.",
        logo: net,
        color: "#512BD4"
      },
      {
        name: "PHP",
        description: "Picked up PHP (Laravel) because I needed it for work.",
        logo: php,
        color: "#777BB4"
      },
    ],
  },
  {
    title: "Frameworks & Libraries",
    tools: [
      {
        name: "Flutter",
        description: "My go-to framework for building beautiful, cross-platform applications.",
        logo: flutter,
        color: "#0175C2"
      },
      {
        name: "SwiftUI",
        description: "Declarative UI for Apple platforms.",
        logo: swift,
        color: "#F05138"
      },
      {
        name: "React.js",
        description: "Building dynamic and reusable UI components.",
        logo: react,
        color: "#61DAFB"
      },
      {
        name: "ASP.NET MVC",
        description: "Robust web apps with C#.",
        logo: net,
        color: "#512BD4"
      },
      {
        name: "Laravel",
        description: "PHP web framework for quick, elegant apps.",
        logo: php,
        color: "#FF2D20"
      },
      {
        name: "Riverpod",
        description: "State management for Flutter that scales.",
        logo: flutter,
        color: "#06C1A8"
      },
      {
        name: "Bloc",
        description: "Predictable state management for Flutter.",
        logo: flutter,
        color: "#00B4AB"
      },
    ],
  },
  {
    title: "Databases",
    tools: [
      {
        name: "PostgreSQL",
        description: "Relational database for structured data.",
        logo: postgresql,
        color: "#4169E1"
      },
      {
        name: "MySQL",
        description: "Classic relational database.",
        logo: mysql,
        color: "#4479A1"
      },
      {
        name: "MongoDB",
        description: "NoSQL for flexible schemas.",
        logo: mongo,
        color: "#47A248"
      },
      {
        name: "SQLite",
        description: "Embedded database for mobile apps.",
        logo: sqlite,
        color: "#003B57"
      },
      {
        name: "Supabase",
        description: "Open source Firebase alternative.",
        logo: supabase,
        color: "#3FCF8E"
      },
    ],
  },
  {
    title: "Cloud & DevOps",
    tools: [
      {
        name: "AWS",
        description: "Cloud services for hosting and scaling.",
        logo: aws,
        color: "#FF9900"
      },
      {
        name: "GCP",
        description: "Google Cloud Platform.",
        logo: gcp,
        color: "#4285F4"
      },
      {
        name: "DigitalOcean",
        description: "Simple and reliable cloud hosting.",
        logo: docean,
        color: "#0080FF"
      },
      {
        name: "Docker",
        description: "Containerizing everything.",
        logo: docker,
        color: "#2496ED"
      },
      {
        name: "Kubernetes",
        description: "Orchestrating containers at scale.",
        logo: kubernetes,
        color: "#326CE5"
      },
      {
        name: "GitHub Actions",
        description: "CI/CD pipelines that just work.",
        logo: githubactions,
        color: "#2088FF"
      },
      {
        name: "Hostinger",
        description: "Affordable hosting for quick deploys.",
        logo: hostinger,
        color: "#673DE6"
      },
    ],
  },
  {
    title: "AI & ML",
    tools: [
      {
        name: "OpenAI API",
        description: "Building AI-powered features.",
        logo: openai,
        color: "#412991"
      },
      {
        name: "Gemini API",
        description: "Google's AI models.",
        logo: gemini,
        color: "#8E75B2"
      },
      {
        name: "Gemma",
        description: "Running models on-device with LiteRT-LM.",
        logo: gemini,
        color: "#8E75B2"
      },
      {
        name: "LLM Integration",
        description: "Weaving AI into products.",
        logo: openai,
        color: "#412991"
      },
      {
        name: "AI-Powered Features",
        description: "AI features in production apps.",
        logo: openai,
        color: "#412991"
      },
    ],
